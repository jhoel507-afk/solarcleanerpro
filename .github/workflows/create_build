name: Build APK y EXE

on:
  push:
    branches: [ main ] # Cambia "main" por tu rama principal si es diferente
  workflow_dispatch: # Esto te permite activar el botón para compilar manualmente

jobs:
  windows:
    runs-on: windows-latest
    steps:
      - name: Checkout del código
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-size: 20 # O la versión que use tu proyecto

      - name: Instalar dependencias
        run: npm install

      - name: Compilar y Empaquetar
        run: npm run dist:win
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }} # <--- Esto evita el error anterior
